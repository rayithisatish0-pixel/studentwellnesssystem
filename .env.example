# Serene Minds - Environment Variables Template
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=serene-minds-super-secure-production-key-2026

# Database Connection (Optional for local/Vercel SQLite, Required for Render/Supabase PostgreSQL)
# Example: postgresql://username:password@hostname:5432/sereneminds_db
DATABASE_URL=

# Port configuration (Defaults to 5000 locally)
PORT=5000
